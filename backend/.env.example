# Copie este archivo como backend/.env y ajuste los valores.

# Pruebas locales (por defecto, no requiere configuración):
# DATABASE_URL=sqlite:///repositorio_dev.db
# Producción:
DATABASE_URL=mysql+pymysql://repo_app:CAMBIAR_CLAVE@127.0.0.1:3306/repositorio_unexpo?charset=utf8mb4

# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_LARGA
JWT_MINUTOS_EXPIRACION=60

MAX_INTENTOS_FALLIDOS=5
MINUTOS_BLOQUEO=15
